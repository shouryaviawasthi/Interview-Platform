PORT=5000
NODE_ENV=development

# Will be updated after ngrok frontend is started
CLIENT_URL=http://localhost:5173

DATABASE_URL=

# Strong JWT secret for production
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Deepgram (Phase 3 — Speech-to-text + diarization)
# Get your key at: https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Groq (Phase 4 — AI Analysis)
# Get your key at: https://console.groq.com
# Recommended replacement for the retired Llama 3.3 model.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=
